{
  "name": "yazan-pi-setup",
  "version": "1.0.0",
  "private": true,
  "description": "Provider-independent Pi extensions and themes",
  "license": "MIT",
  "author": "Yazan Abuashour",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yazanabuashour/pi.git"
  },
  "homepage": "https://github.com/yazanabuashour/pi#readme",
  "bugs": {
    "url": "https://github.com/yazanabuashour/pi/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "effect": "4.1.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@effect/vitest": "4.1.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@oxlint/plugins": "1.94.0",
    "@types/node": "26.6.6",
    "@yazanabuashour/oxlint-config": "file:tools/typescript-lint-policy",
    "oxfmt": "0.78.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typebox": "1.4.7",
    "typescript": "7.0.2",
    "undici-types": "8.12.4",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "type": "module",
  "files": [
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "AUTOMATIONS.md",
    "docs/**/*.md",
    "extensions/**/*.ts",
    "extensions/**/*.cjs",
    "extensions/**/*.md",
    "runtime-probes/automation-telemetry.ts",
    "themes",
    "!extensions/**/*.test.ts",
    "!extensions/**/*.vitest.ts",
    "!extensions/**/*.test-support.ts"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && bash scripts/check && bash scripts/test-declarations && bash scripts/test-update-extensions",
    "install:local": "bash scripts/install-local",
    "update:extensions": "bash scripts/update-extensions",
    "test:integration": "bash scripts/test-integration",
    "format": "oxfmt \"extensions/**/*.{ts,cjs}\" \"runtime-probes/**/*.ts\" \"*.{json,ts}\" \"themes/*.json\"",
    "format:check": "oxfmt --check \"extensions/**/*.{ts,cjs}\" \"runtime-probes/**/*.ts\" \"*.{json,ts}\" \"themes/*.json\"",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --test --experimental-strip-types \"extensions/**/*.test.ts\" \"runtime-probes/*.test.ts\"",
    "test:vitest": "vitest run",
    "typecheck": "bash scripts/patch-declarations && tsc --noEmit"
  }
}
