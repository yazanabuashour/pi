{
  "name": "yazan-pi-setup",
  "version": "1.0.0",
  "private": true,
  "description": "Provider-independent Pi extensions, skills, and themes",
  "license": "MIT",
  "author": "Yazan Abuashour",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yazanabuashour/pi.git"
  },
  "homepage": "https://github.com/yazanabuashour/pi#readme",
  "bugs": {
    "url": "https://github.com/yazanabuashour/pi/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./runtime-probes/automation-telemetry.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "acorn": "^8.18.0",
    "effect": "4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@effect/vitest": "4.0.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@oxlint/plugins": "1.85.0",
    "@types/node": "24.19.0",
    "@yazanabuashour/oxlint-config": "github:yazanabuashour/typescript-lint-policy#7f3e73ef13e465e1ebacde064ee66c43d88ce618",
    "@yazanabuashour/tsconfig": "github:yazanabuashour/typescript-config-policy#9dcc605043afd24e3be1ca5f675939b177f3f2fd",
    "oxfmt": "0.71.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "undici-types": "7.24.6",
    "vite": "8.1.5",
    "vitest": "5.0.3"
  },
  "type": "module",
  "files": [
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "AUTOMATIONS.md",
    "docs/**/*.md",
    "extensions/**/*.ts",
    "extensions/**/*.cjs",
    "extensions/**/*.md",
    "runtime-probes/automation-telemetry.ts",
    "skills",
    "themes",
    "!extensions/**/*.test.ts",
    "!extensions/**/*.vitest.ts",
    "!extensions/**/*.test-support.ts"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && bash scripts/check && bash scripts/test-declarations",
    "install:local": "bash scripts/install-local",
    "test:integration": "bash scripts/test-integration",
    "test:delivery": "bash scripts/test-lost-message-trial",
    "format": "oxfmt \"extensions/**/*.{ts,cjs}\" \"runtime-probes/**/*.{ts,mjs}\" \"*.{json,ts}\" \"themes/*.json\"",
    "format:check": "oxfmt --check \"extensions/**/*.{ts,cjs}\" \"runtime-probes/**/*.{ts,mjs}\" \"*.{json,ts}\" \"themes/*.json\"",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --test --experimental-strip-types \"extensions/**/*.test.ts\"",
    "test:vitest": "vitest run",
    "typecheck": "bash scripts/patch-declarations && tsc --noEmit"
  }
}
