#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
temporary="$(mktemp -d)"
trap 'rm -rf -- "$temporary"' EXIT
repo="$temporary/repo"
fixture="$repo/runtime-probes/integration-deps"
mkdir -p "$repo/scripts" "$fixture" "$temporary/bin"
cp "$ROOT/.npmrc" "$repo/"
cp "$ROOT/scripts/update-extensions" "$repo/scripts/"
cp "$ROOT/runtime-probes/integration-deps/"package*.json "$fixture/"
jq '.packages["node_modules/agent-browser"].resolved = "file:../outside"' \
  "$fixture/package-lock.json" >"$temporary/bad-lock.json"

cat >"$temporary/bin/npm" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
temporary="$(dirname "$(dirname "$0")")"
failure="$(<"$temporary/failure")"
case "$1" in
  install)
    cmp .npmrc "$temporary/repo/.npmrc"
    [[ -z ${npm_config_min_release_age+x} && " $* " == *" --save-prod "* ]]
    [[ ! -e package-lock.json && " $* " == *" --ignore-scripts "* ]]
    printf '\n' >>package.json
    if [[ $failure == source ]]; then
      cp "$temporary/bad-lock.json" package-lock.json
    else
      cp "$temporary/repo/runtime-probes/integration-deps/package-lock.json" .
    fi
    printf '\n' >>package-lock.json
    ;;
  audit) ;;
  *) exit 1 ;;
esac
[[ $failure != "$1" ]] || exit 1
SH
printf '#!/bin/sh\nexit 1\n' >"$temporary/bin/pi"
chmod +x "$temporary/bin/"{npm,pi}
export PATH="$temporary/bin:$PATH" PI_CODING_AGENT_DIR="$temporary/agent"
export npm_config_min_release_age=0
for failure in install source audit; do
  printf '%s\n' "$failure" >"$temporary/failure"
  if bash "$repo/scripts/update-extensions"; then
    printf 'Update unexpectedly passed: %s\n' "$failure" >&2
    exit 1
  fi
  for file in package.json package-lock.json; do
    cmp "$fixture/$file" "$ROOT/runtime-probes/integration-deps/$file"
  done
done
printf 'none\n' >"$temporary/failure"
bash "$repo/scripts/update-extensions"
for file in package.json package-lock.json; do
  cp "$ROOT/runtime-probes/integration-deps/$file" "$temporary/expected"
  printf '\n' >>"$temporary/expected"
  cmp "$fixture/$file" "$temporary/expected"
done
printf 'Extension snapshot tests passed.\n'
