#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 3 ]] || {
  printf 'Usage: %s PI_EXECUTABLE INSTALLED_PACKAGE NEW_RECEIPT_DIRECTORY\n' "${0##*/}" >&2
  exit 2
}
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
resolve_path() {
  node -e 'console.log(require("node:fs").realpathSync(process.argv[1]))' "$1"
}
hash() {
  node -e 'console.log(require("node:crypto").createHash("sha256").update(require("node:fs").readFileSync(process.argv[1])).digest("hex"))' "$1"
}
pi="$(resolve_path "$1")"
package="$(resolve_path "$2")"
[[ -x $pi && $package == */node_modules/yazan-pi-setup ]]
[[ -d $package/node_modules ]]
adapter=extensions/swarm/src/swarm-delivery.ts
# Refuse a stale installation: positive cases must exercise this source candidate.
cmp "$ROOT/$adapter" "$package/$adapter"
cmp "$ROOT/extensions/swarm/src/extension-session.ts" "$package/extensions/swarm/src/extension-session.ts"
mkdir -- "$3"
output="$(resolve_path "$3")"
temporary="$(mktemp -d)"
trap 'rm -rf -- "$temporary"' EXIT
# Native Pi supplies the SDK; the installed candidate supplies the real adapter.
mkdir "$temporary/runtime-probes"
cp "$ROOT/runtime-probes/lost-message-trial.ts" "$temporary/runtime-probes/"
ln -s "$package/extensions" "$temporary/extensions"
ln -s "$package/node_modules" "$temporary/node_modules"
jq -n --arg pi "$pi" --arg version "$("$pi" --version)" \
  --arg node "$(node --version)" --arg date "$(date -u +%FT%TZ)" \
  --arg source "$(git -C "$ROOT" rev-parse HEAD)" \
  --arg fixture "$(hash "$ROOT/runtime-probes/lost-message-trial.ts")" \
  --arg runner "$(hash "$ROOT/scripts/test-lost-message-trial")" \
  --arg package "$package" --arg adapter "$(hash "$package/$adapter")" \
  '{pi: $pi, version: $version, node: $node, date: $date, sourceBase: $source,
    fixtureSha256: $fixture, runnerSha256: $runner, installedPackage: $package,
    adapterSha256: $adapter}' >"$output/environment.json"

run_probe() {
  local mode="$1" home="$temporary/$1" prompt='Run the synthetic pending tool.'
  mkdir -p "$home/.pi/agent" "$home/run"
  chmod 700 "$home/run"
  printf '%s\n' '{"compaction":{"enabled":false},"retry":{"enabled":false}}' \
    >"$home/.pi/agent/settings.json"
  [[ $mode != idle ]] || prompt='/trial-idle'
  if ! (cd "$home" &&
    env -i PATH="$PATH" HOME="$home" PI_OFFLINE=1 \
      PI_CODING_AGENT_DIR="$home/.pi/agent" \
      XDG_CONFIG_HOME="$home/config" XDG_DATA_HOME="$home/data" \
      XDG_STATE_HOME="$home/state" XDG_CACHE_HOME="$home/cache" \
      XDG_RUNTIME_DIR="$home/run" \
      PI_TRIAL_MODE="$mode" PI_TRIAL_RECEIPT="$output/$mode.receipt.jsonl" \
      "$pi" --mode json --no-session --no-context-files --no-approve \
      --no-extensions --no-skills --no-prompt-templates --no-themes \
      -e "$temporary/runtime-probes/lost-message-trial.ts" --tools trial_pending_tool \
      --model pi-lost-message-trial/faux-1 --thinking off \
      --system-prompt 'Synthetic delivery trial.' "$prompt" \
      </dev/null >"$output/$mode.events.jsonl" 2>"$output/$mode.stderr"); then
    printf 'Native Pi failed in %s; diagnostics: %s\n' "$mode" "$output" >&2
    return 1
  fi

  jq -s -e --arg mode "$mode" '
    map(.event) == (if $mode == "idle" then
        ["session_start", "submit", "provider_request", "turn_end",
         "agent_settled", "session_shutdown"]
      else
        ["session_start", "provider_request", "tool_pending", "submit",
         "tool_release", "tool_execution_end", "turn_end", "provider_request",
         "turn_end", "agent_settled", "session_shutdown"]
      end)
    and .[0].mode == $mode and .[0].isIdle == true
    and ([.[] | select(.event == "submit")] == [{event: "submit",
      isIdle: ($mode == "idle"), path: "installed-adapter"}])
    and all(.[] | select(.event == "tool_execution_end"); .isError == false)
    and all(.[] | select(.event == "agent_settled" or .event == "session_shutdown");
      .isIdle == true and .historyHasMarker == true)
    and (.[0].marker as $marker | [.[] | select(.event == "provider_request")] as $requests
      | ($requests | length) == (if $mode == "idle" then 1 else 2 end)
      and $requests[-1].historyHasMarker == true
      and (if $mode == "idle" then true else
        ($requests[0].messages | tostring | contains($marker) | not)
        and $requests[0].historyHasMarker == false
        and any($requests[-1].messages[];
          .role == "toolResult" and .content == [{type: "text", text: "tool-completed"}])
        end))
  ' "$output/$mode.receipt.jsonl" >/dev/null || {
    printf 'Trial schedule failed in %s: %s\n' "$mode" "$output" >&2
    return 1
  }
  jq -s -e --slurpfile receipt "$output/$mode.receipt.jsonl" '
    any(.[]; .type == "message_end" and .message.role == "custom"
      and .message.content == $receipt[0].marker and .message.display == true)
    and ([.[] | select(.type == "message_end" and .message.role == "assistant")]
      | last | .message.stopReason == "stop"
        and .message.content == [{type: "text", text: "pi-lost-message-trial-ok"}])
  ' "$output/$mode.events.jsonl" >/dev/null || {
    printf 'Trial UI event or final response failed in %s: %s\n' "$mode" "$output" >&2
    return 1
  }
}

provider_has_marker() {
  jq -s -e --argjson expected "$2" '
    .[0].marker as $marker
    | [.[] | select(.event == "provider_request")][-1].messages
    | (tostring | contains($marker)) == $expected
  ' "$output/$1.receipt.jsonl" >/dev/null
}

for mode in busy idle; do
  run_probe "$mode"
  provider_has_marker "$mode" true || {
    printf 'Provider-input oracle failed in %s: %s\n' "$mode" "$output" >&2
    exit 1
  }
  printf '%s: provider oracle, history, UI events, schedule, and settlement passed.\n' "$mode"
done

# Prove the oracle rejects context loss despite successful history/UI delivery.
run_probe omitted-context
if provider_has_marker omitted-context true; then
  printf 'Negative control failed: the provider-input oracle accepted the omitted message.\n' >&2
  exit 1
fi
provider_has_marker omitted-context false
printf 'Negative control rejected: provider request 2 omitted the marker; history, UI events, schedule, and settlement passed.\n'
printf 'Native delivery receipts: %s\n' "$output"
