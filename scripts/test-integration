#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 4 || $# -eq 5 ]] || {
  printf 'Usage: %s PI_EXECUTABLE PERSONAL_PACKAGE WEB_PACKAGE BROWSER_PACKAGE [NEW_RECEIPT_DIRECTORY]\n' "${0##*/}" >&2
  exit 2
}
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
resolve_path() {
  node -e 'console.log(require("node:fs").realpathSync(process.argv[1]))' "$1"
}
pi="$(resolve_path "$1")"
package="$(resolve_path "$2")"
web="$(resolve_path "$3")"
browser="$(resolve_path "$4")"
[[ -x $pi ]]
for path in "$package/package.json" "$web/package.json" "$browser/skills/agent-browser/SKILL.md" \
  "$package/skills/workflow-authoring/pi-agents.mjs" "$package/skills/workflow-authoring/structured-output.ts"; do
  [[ -r $path ]] || {
    printf 'Missing package integration input: %s\n' "$path" >&2
    exit 1
  }
done
prefix="$(dirname "$(dirname "$package")")"
[[ $package == "$prefix/node_modules/yazan-pi-setup" ]] || {
  printf 'Expected an installed package at PREFIX/node_modules/yazan-pi-setup: %s\n' "$package" >&2
  exit 2
}

# The installed root uses the source lock's layout, not a consumer's hoisted tree.
cmp "$ROOT/package-lock.json" "$package/package-lock.json"
jq -e --slurpfile locked "$ROOT/package-lock.json" '
  def production($entries): .dev != true and .peer != true
    and (if .link == true then $entries[.resolved].dev != true else true end);
  .packages as $installed | $locked[0].packages as $expected
  | all($installed | to_entries[]; . as $entry
      | $expected[$entry.key] as $source
      | $source != null
        and ([$entry.value.version, $entry.value.resolved, $entry.value.integrity]
          == [$source.version, $source.resolved, $source.integrity]))
    and all($expected | to_entries[]
      | select(.key != "" and (.value | production($expected)
          and .optional != true and .devOptional != true));
      .key as $path | $installed | has($path))
' "$package/node_modules/.package-lock.json" >/dev/null || {
  printf 'Installed production dependencies differ from package-lock.json.\n' >&2
  exit 1
}
installed_records="$(jq -r '.packages as $entries | .packages | to_entries[]
  | [.key, (.value.version // "-"), (.value.dev == true or .value.peer == true
    or (.value.link == true and $entries[.value.resolved].dev == true))] | @tsv' \
  "$package/node_modules/.package-lock.json")"
while IFS=$'\t' read -r path version development; do
  if [[ $development == true ]]; then
    [[ ! -e $package/$path ]] || {
      printf 'Development dependency was installed: %s\n' "$path" >&2
      exit 1
    }
    continue
  fi
  jq -e --arg version "$version" '.version == $version' \
    "$package/$path/package.json" >/dev/null || {
    printf 'Installed dependency %s does not match locked version %s.\n' "$path" "$version" >&2
    exit 1
  }
done <<<"$installed_records"
printf 'Installed production dependency versions and npm integrity records match the source lock.\n'

if [[ $# -eq 5 ]]; then
  mkdir -- "$5"
  receipts="$(resolve_path "$5")"
else
  receipts="$(mktemp -d)"
fi
printf 'Retained integration receipt directory: %s\n' "$receipts"
jq -n --arg pi "$("$pi" --version)" --arg node "$(node --version)" \
  --arg web "$(jq -r '.version' "$web/package.json")" \
  --arg browser "$(jq -r '.version' "$browser/package.json")" \
  --arg source "$(git -C "$ROOT" rev-parse HEAD)" \
  '{pi: $pi, node: $node, web: $web, browser: $browser, sourceBase: $source}' \
  >"$receipts/environment.json"

temporary="$(mktemp -d)"
trap 'rm -rf -- "$temporary"' EXIT
mkdir -p "$temporary/home/.pi/agent" "$temporary/probe" "$temporary/config" \
  "$temporary/data" "$temporary/state" "$temporary/cache" "$temporary/run"
chmod 700 "$temporary/run"
current="$temporary/home/.local/share/dotfiles-pi-package/current"
mkdir -p "$(dirname "$current")"
ln -s "$prefix" "$current"
# Keep SDK imports outside the checkout so native Pi, not dev deps, supplies them.
cp "$ROOT/runtime-probes/package-probe.ts" "$temporary/probe/index.ts"
cp "$ROOT/runtime-probes/package-probe-receipts.ts" "$temporary/probe/"
printf '%s\n' '{"name":"dotfiles-package-probe","pi":{"extensions":["./index.ts"]}}' \
  >"$temporary/probe/package.json"
jq -n --arg package "$current/node_modules/yazan-pi-setup" \
  --arg web "$web" --arg browser "$browser" --arg probe "$temporary/probe" '{
    packages: [$package, $web, {
      source: $browser, extensions: [], skills: ["skills/agent-browser/SKILL.md"],
      prompts: [], themes: []
    }, $probe],
    defaultProvider: "dotfiles-package-probe", defaultModel: "probe",
    defaultThinkingLevel: "off", compaction: {enabled: false}, retry: {enabled: false}
  }' >"$temporary/home/.pi/agent/settings.json"

probe_env=(env -i PATH="$PATH" PI_OFFLINE=1 HOME="$temporary/home" TMPDIR="$temporary"
  PI_EXECUTABLE="$pi" PI_CODING_AGENT_DIR="$temporary/home/.pi/agent"
  XDG_CONFIG_HOME="$temporary/config" XDG_DATA_HOME="$temporary/data"
  XDG_STATE_HOME="$temporary/state" XDG_CACHE_HOME="$temporary/cache"
  XDG_RUNTIME_DIR="$temporary/run"
  DOTFILES_PI_PROBE_BROWSER_SKILL="$browser/skills/agent-browser/SKILL.md")

run_probe() {
  local label="$2" missing="${3:-0}"
  local events="$receipts/$label.events.jsonl" stderr="$receipts/$label.stderr"
  local hooks="$receipts/$label.hooks.jsonl"
  : >"$hooks"
  (cd "$temporary/home" &&
    "${probe_env[@]}" DOTFILES_PI_PROBE_EVENTS="$hooks" \
      DOTFILES_PI_PROBE_PROVIDER_EVENTS="$receipts/$label.provider.jsonl" \
      DOTFILES_PI_PROBE_MISSING_TOOL="$missing" \
      PI_AUTOMATION_TELEMETRY_PATH="$1" PI_AUTOMATION_NAME=package-probe \
      PI_AUTOMATION_RUN_ID=offline \
      node "$ROOT/runtime-probes/package-probe-client.ts" "$pi" "$label" \
      </dev/null >"$events" 2>"$stderr") || {
    printf 'Package integration process failed. Synthetic diagnostics:\n' >&2
    cat "$stderr" "$events" >&2
    return 1
  }
  if [[ $missing == 1 ]]; then
    jq -s -e '
      any(.[]; .type == "message_end" and .message.role == "assistant"
        and .message.stopReason == "error"
        and (.message.errorMessage | contains("missing required tool: web_search")))
      and all(.[]; .type != "tool_execution_start")
    ' "$events" >/dev/null
    printf 'Negative control rejected a missing required web tool before execution.\n'
    return
  fi
  jq -s -e '
    any(.[]; .type == "agent_settled" and (.aborted // false) == false)
    and ([.[] | select(.type == "message_end" and .message.role == "assistant")]
      | last | .message.stopReason == "stop"
        and .message.content == [{type:"text",text:"dotfiles-package-probe-ok"}])
  ' "$events" >/dev/null || {
    cat "$stderr" "$events" >&2
    return 1
  }
  jq -s -e '
    group_by(.sessionId) | length == 2
    and all(.[];
      .[0].type == "session_start" and .[-1].type == "session_shutdown"
      and if .[0].mode == "rpc" then
        any(.[]; .type == "agent_settled")
        and ([.[] | select(.type == "tool_execution_start") | .toolName]
          == ["package_probe", "delegate"])
        and ([.[] | select(.type == "tool_execution_end") | .toolName]
          == ["package_probe", "delegate"])
        and all(.[] | select(.type == "tool_execution_end"); .isError == false)
      else
        .[0].mode == "print"
        and map(.type) == ["session_start", "agent_settled", "session_shutdown"]
        and (.[0].sessionFile | type == "string")
      end)
    and ([.[] | .[0].mode] | sort == ["print", "rpc"])
  ' "$hooks" >/dev/null || {
    cat "$stderr" "$events" "$hooks" >&2
    return 1
  }
  local child_session
  child_session="$(jq -r 'select(.type == "session_start" and .mode == "print") | .sessionFile' "$hooks")"
  cp -- "$child_session" "$receipts/$label.child.session.jsonl"
  jq -s -e '
    .[0].type == "session"
    and any(.[]; .type == "message" and .message.role == "assistant"
      and .message.stopReason == "stop"
      and .message.content == [{type:"text",text:"dotfiles-native-delegate-completed"}])
  ' "$receipts/$label.child.session.jsonl" >/dev/null
  printf 'Delegate answer and saved session ID reached provider input; parent/child settled and shut down; native process exited.\n'
}

run_probe "$receipts/negative-telemetry.jsonl" missing-tool 1
run_probe "$receipts/telemetry.jsonl" success
jq -s -e '
  all(.[]; .schema == "pi-automation-telemetry/v1")
  and .[0].event == "session_start"
  and ([.[] | select(.event == "session_start")] | length == 1)
  and ([.[] | select(.event == "summary")] | length == 1)
  and ([.[] | select(.event == "tool_start") | .toolName]
    == ["package_probe", "delegate"])
  and ([.[] | select(.event == "tool_end") | .toolName]
    == ["package_probe", "delegate"])
  and all(.[] | select(.event == "tool_end"); .isError == false and .orphanEnd == false)
  and any(.[]; .event == "agent_settled")
  and .[-1].event == "summary" and .[-1].settled == true
  and .[-1].calls == 2 and .[-1].errors == 0 and .[-1].orphanedTools == 0
' "$receipts/telemetry.jsonl" >/dev/null

# A directory is an intentionally invalid diagnostic destination.
run_probe "$temporary" invalid-telemetry
grep -Fq 'pi-telemetry-open-failed:' "$receipts/invalid-telemetry.stderr"

# Exercise the installed library, not a copied helper or a nonexistent helper CLI.
cat >"$temporary/run.mjs" <<'JS'
import assert from "node:assert/strict";
import { writeFileSync } from "node:fs";
import { pathToFileURL } from "node:url";
const { agent, parallel } = await import(pathToFileURL(process.argv[2]).href);
const schema = {
  type: "object",
  properties: { result: { const: "dotfiles-native-workflow-completed", type: "string" } },
  required: ["result"],
  additionalProperties: false,
};
const results = await parallel([
  () => agent("Return the synthetic native workflow fixture.", { label: "valid", model: "dotfiles-package-probe/probe", schema }),
  () => agent("Return an invalid synthetic workflow fixture.", { label: "invalid", model: "dotfiles-package-probe/probe", schema }),
  () => agent("Fail the synthetic native workflow fixture.", { label: "failure", model: "dotfiles-package-probe/probe" }),
]);
writeFileSync(process.argv[3], JSON.stringify(results, null, 2));
assert.equal(results[0].ok, true);
assert.deepEqual(results[0].structured, { result: "dotfiles-native-workflow-completed" });
assert.equal(results[1].ok, false);
assert.equal(results[1].structured, undefined);
assert.match(results[1].error, /structured_output/);
assert.equal(results[2].ok, false);
assert.match(results[2].error, /synthetic workflow provider failure/);
assert.equal(new Set(results.map((result) => result.sessionId)).size, 3);
assert.ok(results.every((result) => result.model === "dotfiles-package-probe/probe"));
JS
(cd "$temporary/home" &&
  "${probe_env[@]}" DOTFILES_PI_PROBE_EVENTS="$receipts/workflow.hooks.jsonl" \
    DOTFILES_PI_PROBE_PROVIDER_EVENTS="$receipts/workflow.provider.jsonl" \
    PI_AUTOMATION_TELEMETRY_PATH="$receipts/workflow-parent-telemetry.jsonl" \
    PI_AUTOMATION_NAME=workflow-parent PI_AUTOMATION_RUN_ID=offline \
    node "$temporary/run.mjs" "$package/skills/workflow-authoring/pi-agents.mjs" \
    "$receipts/workflow.results.json" >"$receipts/workflow.stdout" 2>"$receipts/workflow.stderr") || {
  cat "$receipts/workflow.stderr" >&2
  exit 1
}
[[ ! -e $receipts/workflow-parent-telemetry.jsonl ]]
jq -s -e '
  group_by(.sessionId) | length == 3
  and all(.[]; .[0].type == "session_start" and .[-1].type == "session_shutdown"
    and any(.[]; .type == "agent_settled"))
' "$receipts/workflow.hooks.jsonl" >/dev/null
while IFS= read -r session; do
  cp -- "$session" "$receipts/workflow.$(basename "$session")"
done < <(jq -r 'select(.type == "session_start") | .sessionFile' "$receipts/workflow.hooks.jsonl")
jq -s -e --arg tmpdir "$temporary" 'all(.[]; .tmpdir == $tmpdir)' \
  "$receipts/workflow.provider.jsonl" >/dev/null
[[ -z $(find "$temporary" -maxdepth 1 -name 'pi-agent-schema-*' -print -quit) ]]
printf 'Installed workflow helper validated structured output, rejected invalid output and provider failure, preserved TMPDIR, saved child sessions, settled, and cleaned schema files.\n'
printf 'Installed package discovery, native SDK imports, delegated child delivery, tool lifecycle, and optional telemetry passed.\n'
