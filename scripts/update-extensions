#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ $# -ne 0 ]]; then
  printf 'Usage: npm run update:extensions\n' >&2
  exit 2
fi

fixture="$ROOT/runtime-probes/integration-deps"
temporary="$(mktemp -d)"
trap 'rm -rf -- "$temporary"' EXIT
cd "$temporary"
cp "$ROOT/.npmrc" "$fixture/package.json" .
npm=(env -i PATH="$PATH" HOME="$temporary/home" npm_config_globalconfig="$temporary/global-npmrc" npm)
"${npm[@]}" install --registry=https://registry.npmjs.org/ --package-lock-only --save-exact --save-prod \
  --ignore-scripts --legacy-peer-deps --no-audit --no-fund pi-web-access@latest agent-browser@latest
jq -e 'all(.packages | to_entries[]; .key == "" or (
  (.key | startswith("node_modules/")) and (.value.resolved | startswith("https://registry.npmjs.org/"))
  and (.value.integrity | type == "string")))' package-lock.json >/dev/null
"${npm[@]}" audit --registry=https://registry.npmjs.org/ --omit=dev
cp package.json package-lock.json "$fixture/"
printf 'Updated the CI dependencies. Run the source and integration gates before committing.\n'
